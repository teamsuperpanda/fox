default_platform(:ios)

platform :ios do
  lane :beta do
    setup_ci if ENV["CI"]
    match(type: "appstore")
    build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store"
    )
    testflight_options = { skip_waiting_for_build_processing: true }
    changelog_path = "fastlane/metadata/en-US/release_notes.txt"
    if File.exist?(changelog_path)
      testflight_options[:changelog] = File.read(changelog_path)
    end
    upload_to_testflight(**testflight_options)
  end

  lane :release do
    setup_ci if ENV["CI"]
    match(type: "appstore")
    build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store"
    )
    upload_to_app_store(
      skip_waiting_for_build_processing: true
    )
  end
end
